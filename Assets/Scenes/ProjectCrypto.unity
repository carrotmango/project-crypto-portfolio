  dialogueText: {fileID: 1654954368}
  typingSpeed: 0.03
  messages:
  - "\uC548\uB155! \uC77C\uB2F9\uC774 \uD544\uC694\uD560 \uB54C,  \uBC14\uB85C \uC77C\uAC70\uB9AC\uB97C
    \uCC3E\uC544\uC8FC\uB294 \uB9DD\uACE0 \uC778\uB825\uC18C\uC5D0 \uC628 \uAC78
    \uD658\uC601\uD574!"
  - "\uB2E8\uAE30 \uC54C\uBC14\uAC00 \uD544\uC694\uD558\uB2E4\uACE0? \uC798\uC654\uC5B4
    \uC6B0\uB9AC \uC778\uB825\uC18C\uC5D0\uC11C \uCC3E\uC544\uBD10!"
  - "\uC5B4\uC11C\uC640! \uC5EC\uAE30\uB294 \uB9DD\uACE0 \uC778\uB825\uC18C ! \uAE09\uC804\uC774
    \uD544\uC694\uD560 \uB550 \uC774\uB9CC\uD55C \uACF3\uC774 \uC5C6\uC9C0!"
